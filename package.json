{
  "name": "velvet-abyss",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Velvet Abyss — a dark, mobile-first casino of strange and dangerous games (play money only).",
  "scripts": {
    "dev": "vite",
    "assets": "python3 scripts/build_assets.py",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@fontsource/jacquard-24": "5.3.0",
    "@fontsource/jersey-15": "5.3.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.0.18"
  }
}
